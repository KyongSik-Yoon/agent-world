{
  "name": "agent-world",
  "version": "0.7.4",
  "description": "A 3D village for the coding agents running in herdr — see who needs you, talk to them, and build new workspaces from the browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "AGENT_WORLD_DEV=1 bun --hot server/index.ts",
    "probe": "bun server/probe.ts",
    "url": "bun server/url.ts",
    "i18n": "bun dev/i18n-check.ts",
    "typecheck": "tsc --noEmit",
    "perf": "bun dev/perf/run.ts",
    "perf:lint": "bun dev/perf/lint.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/three": "0.172.0",
    "typescript": "^7.0.2"
  }
}
